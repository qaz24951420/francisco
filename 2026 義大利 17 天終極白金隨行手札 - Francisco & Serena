      </table>

      <!-- 鞋子與盥洗與3C -->
      <table class="w-full text-xs sm:text-sm text-left border-collapse bg-white rounded-xl overflow-hidden shadow-sm">
        <thead class="bg-stone-200 text-stone-700"><tr><th class="p-2 w-10 text-center">✓</th><th class="p-2">👟 鞋類、保養盥洗與 3C</th><th class="p-2 text-center w-16">數量</th></tr></thead>
        <tbody class="divide-y divide-stone-100 border border-stone-200">
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2 font-bold text-amber-800">亞瑟士 GEL-NIMBUS 28 步行鞋</td><td class="p-2 text-center">1雙</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">備用休閒鞋 / 房內輕便拖鞋</td><td class="p-2 text-center">各1雙</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">Medicube 臉部保濕保養品</td><td class="p-2 text-center">1套</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">悠斯晶 (Yuskin) 護手足霜</td><td class="p-2 text-center">1罐</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2 font-bold text-red-600">牙刷與牙膏 (歐洲 90% 不提供)</td><td class="p-2 text-center">2套</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">常備藥品 (腸胃/止痛/感冒/OK繃)</td><td class="p-2 text-center">1包</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">萬國轉接頭 (義大利雙孔/三孔圓柱)</td><td class="p-2 text-center">3個</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">行動電源 (重度導航必備) / 線材</td><td class="p-2 text-center">2顆</td></tr>
          <tr><td class="p-2 text-center"><span class="print-checkbox"></span></td><td class="p-2">iPhone 16 Plus / Apple Watch</td><td class="p-2 text-center">隨身</td></tr>
